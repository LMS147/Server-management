@inject ManagementState State
@implements IDisposable
<div class="shell">
    <main>
        @if(State.Error is not null){<div class="alert error" role="alert">@State.Error</div>}
        @if(State.Notice is not null){<div class="alert" role="status">@State.Notice</div>}
        @if(State.Busy){<div class="working" role="status"><span class="status-dot pulse"></span> Contacting server…</div>}
        @switch(State.Page)
        {
            case "Dashboard": <Dashboard State="State" /> break;
            case "Services": <Services State="State" /> break;
            case "Connections": <Connections State="State" /> break;
            case "Logs": <Logs State="State" /> break;
            case "Settings": <Settings State="State" /> break;
        }
    </main>
    <nav aria-label="Main navigation"><div class="nav-inner">
        @foreach(var page in Pages)
        {
            <button disabled="@State.Busy" class="@(State.Page == page ? "active" : "")" aria-current="@(State.Page == page ? "page" : null)" @onclick="() => State.Navigate(page)"><ManagerIcon Name="@Icon(page)" /><span>@(page == "Connections" ? "Connect" : page)</span></button>
        }
    </div></nav>
</div>
@code {
    private static readonly string[] Pages = ["Dashboard", "Services", "Connections", "Logs", "Settings"];
    protected override async Task OnInitializedAsync() { State.Changed += OnChanged; await State.InitializeAsync(); }
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => State.Changed -= OnChanged;
    private static string Icon(string page) => page switch { "Dashboard" => "dashboard", "Services" => "server", "Connections" => "connect", "Logs" => "logs", _ => "settings" };
}
