@inherits ManagementPage
<section><div class="heading"><div><small class="eyebrow">PROCESS CONTROL</small><h1>Services</h1><p>Manage the applications running on your phone.</p></div><button disabled="@State.Busy" @onclick='() => State.RunAsync("status")'>Refresh</button></div>
    <article class="card"><h2>Atlas API</h2><p>@(State.Status is null ? "Not checked" : State.Status.ApiHealthy ? "Healthy at the last check" : "Unavailable at the last check")</p><p>Supervised service · atlas-api</p><div class="actions"><button disabled="@State.Busy" @onclick='() => State.RunAsync("api-start")'>Start</button><button disabled="@State.Busy" @onclick='() => State.RunAsync("api-restart")'>Restart…</button><button class="danger" disabled="@State.Busy" @onclick='() => State.RunAsync("api-stop")'>Stop…</button></div></article>
    <article class="card"><h2>Cloudflare tunnel</h2><p>@(State.Status is null ? "Not checked" : State.Status.TunnelRunning ? "Process running at the last check" : "No connector process at the last check")</p><p>Recovery starts your installed ~/start.sh when the connector is stopped.</p><button disabled="@State.Busy" @onclick='() => State.RunAsync("recover")'>Recover API and tunnel…</button></article>
    <article class="card"><h2>Termux SSH</h2><p>@(State.Reachable ? "Current SSH request succeeded" : "Check the backup connection")</p><p>Keep SSH and Tailscale active to preserve remote recovery access.</p></article>
</section>
