@inherits ManagementPage
<section>
    <div class="page-heading"><div><span class="eyebrow">PROCESS MANAGER</span><h1>Services</h1></div><button class="icon-button" disabled="@State.Busy" aria-label="Refresh services" @onclick='() => State.RunAsync("status")'><ManagerIcon Name="refresh" /></button></div>
    <article class="service-card">
        <div class="server-identity"><span class="icon-tile"><ManagerIcon Name="code" /></span><div class="grow"><h2>Atlas API</h2><p>Python · Port @(State.Status?.ApiPort?.ToString() ?? "—")</p></div><span class="badge @(State.Status?.ApiHealthy == true ? "good" : "")"><i class="status-dot"></i>@(State.Status is null ? "Unchecked" : State.Status.ApiHealthy ? "Running" : "Unavailable")</span></div>
        <div class="process-stats"><div><small>PID</small><strong>@(State.Status?.ApiPid?.ToString() ?? "—")</strong></div><div><small>CPU</small><strong>@(State.Status?.ApiCpuPercent is { } cpu ? $"{cpu:0.#}%" : "—")</strong></div><div><small>MEMORY</small><strong>@(State.Status?.ApiMemoryBytes is { } bytes ? Bytes(bytes) : "—")</strong></div></div>
        <div class="service-actions"><button class="start-button" disabled="@State.Busy" @onclick='() => State.RunAsync("api-start")'><ManagerIcon Name="play" /> Start</button><button disabled="@State.Busy" @onclick='() => State.RunAsync("api-restart")'><ManagerIcon Name="refresh" /> Restart</button><button class="danger" disabled="@State.Busy" @onclick='() => State.RunAsync("api-stop")'><ManagerIcon Name="stop" /> Stop</button></div>
    </article>
    <div class="section-heading"><h2>Runtime details</h2></div>
    <div class="list-card details-card"><div><span>Connection</span><strong>Private SSH</strong></div><div><span>API version</span><strong>@(State.Status?.ApiVersion ?? "Unavailable")</strong></div><div><span>Runtime</span><strong>Python · Termux</strong></div><div><span>API uptime</span><strong>@Duration(State.Status?.ApiUptimeSeconds)</strong></div></div>
    <div class="info-note"><ManagerIcon Name="info" /><span>Service controls run securely over your configured SSH connection.</span></div>
    <p class="helper">Missing or restricted process metrics display —. Last status check: @Checked.</p>
</section>
