@inherits ManagementPage
<section>
    <div class="page-heading"><div><span class="eyebrow">@Greeting</span><h1>Server overview</h1></div><button class="icon-button notification-button" disabled="@State.Busy" aria-label="Open status alert settings" @onclick='() => State.Navigate("Settings")'><ManagerIcon Name="alert" />@if(State.StatusAlerts){<i></i>}</button></div>
    <article class="overview-card">
        <div class="server-identity"><span class="icon-tile large"><ManagerIcon Name="server" /></span><div class="grow"><h2>@(State.Connection?.Name ?? "Your server")</h2><p>@(State.Status?.Hostname ?? State.Connection?.Host ?? "Configure your connection")</p></div><span class="badge @(State.Reachable ? "good" : "")"><span class="status-dot"></span>@(State.Reachable ? "Online" : "Unchecked")</span></div>
        <div class="uptime-row"><span>Uptime</span><strong>@Duration(State.Status?.Host.UptimeSeconds)</strong></div>
        <div class="resource-grid">
            <div class="resource-card"><div class="resource-title"><span><ManagerIcon Name="memory" /> Memory</span><strong>@(State.Status?.Host.Ram is { } ram ? $"{Used(ram):0}%" : "—")</strong></div><div class="meter"><span style="width:@Bar(State.Status?.Host.Ram)"></span></div><small>@(State.Status?.Host.Ram is { } memory ? $"{Bytes(memory.TotalBytes - memory.FreeBytes)} of {Bytes(memory.TotalBytes)}" : "Not available")</small></div>
            <div class="resource-card"><div class="resource-title"><span><ManagerIcon Name="storage" /> Storage</span><strong>@(State.Status is { } sample ? $"{Used(sample.Host.Disk):0}%" : "—")</strong></div><div class="meter"><span style="width:@Bar(State.Status?.Host.Disk)"></span></div><small>@(State.Status is { } diskSample ? $"{Bytes(diskSample.Host.Disk.TotalBytes - diskSample.Host.Disk.FreeBytes)} of {Bytes(diskSample.Host.Disk.TotalBytes)}" : "Not available")</small></div>
        </div>
    </article>
    <div class="section-heading"><h2>System status</h2><button class="text-button" disabled="@State.Busy" @onclick='() => State.RunAsync("status")'>@(State.LastChecked is null ? "Check now" : Checked) <ManagerIcon Name="refresh" /></button></div>
    <div class="list-card">
        <button class="service-row" disabled="@State.Busy" @onclick='() => State.Navigate("Services")'><span class="icon-tile"><ManagerIcon Name="code" /></span><span class="grow"><strong>Atlas API</strong><small>Port @(State.Status?.ApiPort?.ToString() ?? "—")</small></span><span class="inline-status @(State.Status?.ApiHealthy == true ? "good" : "")"><i class="status-dot"></i>@(State.Status is null ? "Unchecked" : State.Status.ApiHealthy ? "Healthy" : "Unavailable")</span><ManagerIcon Name="chevron" /></button>
        <button class="service-row" disabled="@State.Busy" @onclick='() => State.Navigate("Services")'><span class="icon-tile"><ManagerIcon Name="cloud" /></span><span class="grow"><strong>Cloudflare tunnel</strong><small>Primary connection</small></span><span class="inline-status @(State.Status?.TunnelRunning == true ? "good" : "")"><i class="status-dot"></i>@(State.Status is null ? "Unchecked" : State.Status.TunnelRunning ? "Running" : "Stopped")</span><ManagerIcon Name="chevron" /></button>
        <button class="service-row" disabled="@State.Busy" @onclick='() => State.Navigate("Connections")'><span class="icon-tile"><ManagerIcon Name="terminal" /></span><span class="grow"><strong>SSH access</strong><small>@(State.Connection?.Host ?? "Tailscale connection")</small></span><span class="inline-status @(State.Reachable ? "good" : "")"><i class="status-dot"></i>@(State.Reachable ? "Online" : "Unchecked")</span><ManagerIcon Name="chevron" /></button>
    </div>
    @if(!State.Reachable && State.Status is not null){<p class="helper">Showing the previous result. Check again to verify current status.</p>}
    <div class="section-heading"><h2>Quick actions</h2></div>
    <div class="quick-actions"><button disabled="@State.Busy" @onclick='() => State.Navigate("Logs")'><span class="icon-tile"><ManagerIcon Name="logs" /></span><span><strong>View logs</strong><small>Inspect activity</small></span></button><button disabled="@(State.Busy || State.Connection is null)" @onclick='() => State.RunAsync("recover")'><span class="icon-tile"><ManagerIcon Name="refresh" /></span><span><strong>Recovery</strong><small>Start missing services</small></span></button></div>
    <p class="helper footnote">Tunnel status reflects its process. Cloudflare confirms connector health.</p>
</section>
@code { private static string Greeting => DateTime.Now.Hour < 12 ? "GOOD MORNING" : DateTime.Now.Hour < 18 ? "GOOD AFTERNOON" : "GOOD EVENING"; }
